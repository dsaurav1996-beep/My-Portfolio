---
---

<section id="resume" class="py-24 px-4">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="text-accent font-mono text-sm mb-2">DOCUMENT</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-text-primary">Resume</h2>
      <div class="w-16 h-1 bg-accent mx-auto mt-4 rounded-full"></div>
    </div>
    
    <div class="reveal">
      <!-- PDF Preview -->
      <div class="bg-bg-secondary border border-bg-tertiary rounded-xl overflow-hidden shadow-lg">
        <!-- Toolbar -->
        <div class="flex items-center justify-between px-4 py-3 bg-bg-primary border-b border-bg-tertiary">
          <div class="flex items-center gap-2 text-sm text-text-secondary">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="font-medium">Saurav_Das_Scrum_PO_2026.pdf</span>
          </div>
          <a 
            href="/resume.pdf" 
            download
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium bg-accent text-bg-primary rounded-lg hover:bg-accent-light transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Download
          </a>
        </div>
        
        <!-- PDF Embed -->
        <div class="w-full aspect-[3/4] max-h-[800px]">
          <iframe 
            src="/resume.pdf" 
            class="w-full h-full border-0"
            title="Saurav Das Resume"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
