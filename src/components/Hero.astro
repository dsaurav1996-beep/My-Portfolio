---
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden px-4">
  <!-- Background orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="orb absolute top-20 left-[10%] w-72 h-72 bg-accent/10 rounded-full blur-3xl"></div>
    <div class="orb orb-delay-1 absolute top-40 right-[15%] w-96 h-96 bg-accent/5 rounded-full blur-3xl"></div>
    <div class="orb orb-delay-2 absolute bottom-20 left-[30%] w-64 h-64 bg-accent/8 rounded-full blur-3xl"></div>
  </div>
  
  <div class="relative z-10 max-w-4xl mx-auto text-center">
    <!-- Role badges -->
    <div class="flex flex-wrap justify-center gap-2 mb-6 reveal">
      <span class="px-3 py-1 text-xs font-mono font-medium bg-accent/10 text-accent border border-accent/20 rounded-full">
        CSM
      </span>
      <span class="px-3 py-1 text-xs font-mono font-medium bg-accent/10 text-accent border border-accent/20 rounded-full">
        CSPO
      </span>
      <span class="px-3 py-1 text-xs font-mono font-medium bg-accent/10 text-accent border border-accent/20 rounded-full">
        Agile Consultant
      </span>
    </div>
    
    <!-- Name -->
    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight mb-4 reveal" style="transition-delay: 100ms;">
      <span class="gradient-text">Saurav Das</span>
    </h1>
    
    <!-- Title -->
    <p class="text-xl sm:text-2xl text-text-secondary font-light mb-6 reveal" style="transition-delay: 200ms;">
      Scrum Master & Product Owner
    </p>
    
    <!-- Summary -->
    <p class="max-w-2xl mx-auto text-text-muted leading-relaxed mb-10 reveal" style="transition-delay: 300ms;">
      Certified Scrum Master and Product Owner with 3.5+ years leading Agile delivery, 
      Scrum of Scrums, and enterprise transformation within Oracle P2P ecosystems. 
      Proven track record of zero-defect go-lives, cross-functional team leadership, 
      and driving business value through data-driven Agile practices.
    </p>
    
    <!-- CTAs -->
    <div class="flex flex-wrap justify-center gap-4 mb-12 reveal" style="transition-delay: 400ms;">
      <a 
        href="#career" 
        class="px-8 py-3 bg-accent text-bg-primary font-semibold rounded-lg hover:bg-accent-light transition-all hover:shadow-lg hover:shadow-accent/25"
      >
        View Experience
      </a>
      <a 
        href="https://linkedin.com/in/Saurav-Das0016" 
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-3 bg-bg-secondary text-text-primary font-semibold rounded-lg border border-bg-tertiary hover:border-accent/50 hover:bg-bg-tertiary/50 transition-all"
      >
        LinkedIn Profile
      </a>
    </div>
    
    <!-- Contact bar -->
    <div class="flex flex-wrap justify-center gap-6 text-sm text-text-muted reveal" style="transition-delay: 500ms;">
      <a href="mailto:dsaurav1996@gmail.com" class="flex items-center gap-2 hover:text-accent transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        dsaurav1996@gmail.com
      </a>
      <span class="hidden sm:inline text-bg-tertiary">|</span>
      <a href="tel:+919051289167" class="flex items-center gap-2 hover:text-accent transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        +91-9051289167
      </a>
      <span class="hidden sm:inline text-bg-tertiary">|</span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Hyderabad, India
      </span>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#skills" class="text-text-muted hover:text-accent transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
