---
const experiences = [
  {
    company: "Cognizant Technology Solutions",
    location: "Hyderabad, India",
    period: "Feb 2023 – Present",
    title: "Scrum Consultant | Product Consultant",
    highlights: [
      "Served as Scrum Master and Product Owner across 4+ concurrent Agile delivery streams, leading cross-functional teams of 6–8 members",
      "Facilitated Scrum of Scrums across teams, resolving cross-functional dependencies and sustaining <strong>90%+ sprint goal completion rate</strong>",
      "Led SIT and UAT execution for Oracle P2P modules across <strong>5 LATAM regions</strong>, delivering <strong>zero-defect go-live</strong> and successful Hypercare support",
      "Designed Jira and Azure DevOps dashboards tracking sprint velocity, burndown metrics, and release readiness, <strong>reducing manual reporting effort by 30%</strong>",
      "Drove continuous improvement through retrospectives, reducing sprint spillover and improving delivery predictability",
      "Led RCA for critical month-end production issues, presenting remediation strategies to business and IT leadership",
      "Authored BRDs and Agile delivery artifacts ensuring traceability, audit compliance, and clear acceptance criteria",
      "Delivered stakeholder-facing solution demonstrations and POCs, accelerating executive buy-in and client confidence",
      "Mentored teams on Scrum principles, backlog readiness, and sprint discipline across distributed delivery teams",
      "<strong>Recognized as Employee of the Month</strong> for excellence in Agile delivery, stakeholder management, and client satisfaction"
    ]
  },
  {
    company: "Cognizant Technology Solutions",
    location: "Kolkata, India",
    period: "Aug 2019 – Dec 2020",
    title: "Programmer Analyst (Developer)",
    highlights: [
      "Supported Agile delivery and modernization of PEGA workflow applications across multiple sprint cycles with <strong>zero post-production defects</strong>",
      "Collaborated with development and QA teams to execute unit and integration testing, improving delivery quality",
      "Drove requirement scoping discussions and sprint planning for PEGA system enhancements across <strong>3 release cycles</strong>",
      "Conducted client demonstrations and knowledge transfer sessions, accelerating onboarding and stakeholder engagement"
    ]
  }
];
---

<section id="career" class="py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="text-accent font-mono text-sm mb-2">JOURNEY</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-text-primary">Professional Experience</h2>
      <div class="w-16 h-1 bg-accent mx-auto mt-4 rounded-full"></div>
    </div>
    
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-bg-tertiary md:-translate-x-px"></div>
      
      {experiences.map((exp, index) => (
        <div class="relative mb-12 last:mb-0 reveal" style={`transition-delay: ${index * 150}ms;`}>
          <!-- Timeline dot -->
          <div class={`absolute left-4 md:left-1/2 w-3 h-3 bg-accent rounded-full border-2 border-bg-primary transform -translate-x-1/2 translate-y-6 z-10 shadow-lg shadow-accent/30`}></div>
          
          <div class={`ml-12 md:ml-0 md:w-1/2 ${index % 2 === 0 ? 'md:pr-12' : 'md:ml-auto md:pl-12'}`}>
            <div class="card-glow bg-bg-secondary border border-bg-tertiary rounded-xl p-6">
              <div class="flex flex-col items-start">
                <span class="inline-block px-3 py-1 text-xs font-mono bg-accent/10 text-accent rounded-full mb-3">
                  {exp.period}
                </span>
                <h3 class="text-xl font-bold text-text-primary mb-1">{exp.title}</h3>
                <p class="text-accent font-medium mb-1">{exp.company}</p>
                <p class="text-text-muted text-sm mb-4">{exp.location}</p>
              </div>
              
              <ul class="space-y-2 text-sm text-text-secondary">
                {exp.highlights.map(highlight => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1.5 w-1.5 h-1.5 bg-accent rounded-full flex-shrink-0"></span>
                    <span class="leading-relaxed" set:html={highlight} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
